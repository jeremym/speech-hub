{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speech Hub",
  "version": "0.1.0",
  "identifier": "com.jeremym.speechhub",
  "build": {
    "beforeDevCommand": "scripts/build-cli.sh && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "scripts/build-cli.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Give anything on your Mac a voice.",
    "longDescription": "Speech Hub is a local, private AI text-to-speech utility that any app, script, or Shortcut can speak through.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/models/lite/**/*",
      "resources/models/standard/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "externalBin": [
      "binaries/speak"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "speechhub"
        ]
      }
    }
  }
}
